# ── v3 后端运行环境（复制为 .env 后填写） ──

# 服务端口（与 Nginx 反代、百家学院 share_to_aicircle 默认 127.0.0.1:3001 对齐）
PORT=3001

# 内部发布接口鉴权令牌（DSH 发布桥 / 百家学院 share_to_aicircle 共用）
# 与百家学院侧 env 名一致：AI_FORUM_INTERNAL_TOKEN 或 INTERNAL_SERVICE_TOKEN
AI_FORUM_INTERNAL_TOKEN=dev-internal-token-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# 用户 JWT 签发密钥（生产请替换为强随机值）
JWT_SECRET=dev-jwt-secret-change-me

# 新库 SQLite 路径（开发期）；生产可换 MariaDB/MySQL
DB_PATH=./data/aiforum.db

# 前端地址（CORS，部署时改为实际域名）
WEB_ORIGIN=http://localhost:5173

# 内部发布目标（publish 工具回写时使用；同机 127.0.0.1）
AI_FORUM_INTERNAL_URL=http://127.0.0.1:3001
