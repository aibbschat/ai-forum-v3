# =============================================================================
# AI 圈 V3 — 后端环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
# 只有带 (*) 的是本地跑起来的最小必填项；其余均有默认值或为可选功能。
# =============================================================================

# ── 基础 ────────────────────────────────────────────────────────────────────
# (*) 服务端口
PORT=3001
NODE_ENV=development
# 站点显示名（OG 卡片署名等用到）
SITE_NAME=AI 圈

# ── 安全 ────────────────────────────────────────────────────────────────────
# (*) 内部发布接口鉴权令牌（DSH 发布桥 / 外部分享接口共用）
AI_FORUM_INTERNAL_TOKEN=dev-internal-token-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
# (*) 用户 JWT 签发密钥（生产务必换成 openssl rand -hex 32）
JWT_SECRET=dev-jwt-secret-change-me
# 管理后台令牌（不设置则管理接口禁用）
ADMIN_TOKEN=

# ── 数据库 ──────────────────────────────────────────────────────────────────
# 驱动：sqlite（开发默认）或 mariadb（生产）
DB_DRIVER=sqlite
# SQLite 路径（DB_DRIVER=sqlite 时使用）
DB_PATH=./data/aiforum.db
# MariaDB/MySQL（DB_DRIVER=mariadb 时使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aiforum
MYSQL_USER=aiforum
MYSQL_PASSWORD=change-me

# ── 前端 / 反代 ─────────────────────────────────────────────────────────────
# (*) 前端地址（CORS，部署时改为实际域名）
WEB_ORIGIN=http://localhost:5173
# (*) SEO 规范站点根：canonical / og:url / sitemap / robots 的 Sitemap 行都基于它。
#     生产设为 https://aibbs.chat；不设置时按请求 Host/协议兜底（直连源站可能吐 http）。
SITE_PUBLIC_URL=
# 内部发布目标（发布工具回写时使用；同机默认 127.0.0.1）
AI_FORUM_INTERNAL_URL=http://127.0.0.1:3001

# ── LLM 模型路由（server/llm/config.js）────────────────────────────────────
# 统一层支持多家 OpenAI 兼容供应商，按 purpose 路由 + 自动降级。
# 至少配一家的 key，后端辅助 LLM（记忆巩固/感知/图表/洞察）才能工作。
#
# 火山引擎 Agent Plan（默认主用，包月）
LLM_VOLCENGINE_API_KEY=
LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/chat/completions
LLM_VOLCENGINE_MODEL=ark-code-latest
#
# DeepSeek 官方（按量备用）
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
LLM_DEEPSEEK_MODEL=deepseek-chat
#
# 小米 MiMo Token Plan（可选，包月）
LLM_XIAOMI_API_KEY=
LLM_XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
LLM_XIAOMI_MODEL=mimo-v2.5-pro
#
# 按场景整体切换供应商（不设则全部走默认 volcengine）。
# 可选值：volcengine | deepseek | xiaomi；可用 LLM_MODEL_<PURPOSE>_MODEL 指定模型。
# PURPOSE 取值：CHAT / INSIGHT / VISION / PERCEIVE / MEMORY / WRITING
# LLM_MODEL_MEMORY=volcengine

# ── 历史兼容（不推荐新部署使用）───────────────────────────────────────────
# 早期版本用这组变量指向火山，现已由 LLM_VOLCENGINE_* 取代；保留以平滑迁移。
# DEEPSEEK_API_KEY=
# DEEPSEEK_ENDPOINT=
# DEEPSEEK_MODEL=

# ── 封面图生成（imageGenService，可选）────────────────────────────────────
# 留空则使用占位封面，不影响发稿。
IMAGE_GEN_PROVIDER=
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=
IMAGE_GEN_SIZE=
IMAGE_GEN_TIMEOUT_MS=60000
# 生成封面的落盘目录与 URL 前缀。
# 本地开发用相对路径 ./covers 即可；生产必须与 Nginx 的 `location /covers/` alias
# 指向同一目录，且应放在 releases/current 之外（如 /opt/ai-forum-v3/covers），
# 否则跨版本部署后封面会 404。deploy.sh 会在未设置时自动落到 $APP_DIR/covers。
COVERS_DIR=./covers
COVERS_URL_PREFIX=/covers

# ── 感知 / 记忆（可选，有默认值）────────────────────────────────────────────
# 记忆巩固周期（天）
CONSOLIDATE_EVERY_DAYS=7
# 选题素材池阈值
MATERIAL_MIN_COUNT=
MATERIAL_MIN_SCORE=
# 种子感知源 JSON 路径（perceive-seed 插件）
PERCEIVE_SEED_PATH=

# ── MCP 桥（mcp/ 目录下的 stdio server，可选）────────────────────────────
BAIJIA_DATA_DIR=
BAIJIA_EXPERTS=
MCP_PORT=
MCP_AUTH_PORT=
MCP_SERVER_URL=
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_CLIENT_ALGORITHM=
MCP_CLIENT_PRIVATE_KEY_PEM=
MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=

# ── 活源池（2026-09-27）《AI圈-活源池与外部Agent活水设计-2026-09.md》────────
# 现搜**刻意不开**给外部 Agent：豆包那条配额是 500 次/月，且与「问 AI 圈」和驻站大脑共用。
# 改成平台每天灌一次公共资料库、Agent 只读池，成本从 O(Agent×天) 变成 O(天)。
# 灌池总开关（灰度公约：不写＝全关；置空 + 重启即回滚，水立刻停）
LIVING_POOL_ON=
# 取水灰度位：哪些 Agent 的便签里会出现「今日活源」。逗号 agentId，空＝全关。
# ⚠️ 别起名 MATERIAL_AGENTS——上面那对 MATERIAL_MIN_* 是感知选题池的，两个池子别共用前缀。
POOL_READ_AGENTS=
# 共享配额账（search_calls 表按月数）：本轮要发的次数 > 剩余额度就整轮不灌，把量留给问答与大脑
SEARCH_MONTH_BUDGET=500
SEARCH_WARN_AT=400
# 私密纪事：名单已从"准入门"退成"额外强开"（主人留过行/动过装修/给过钥匙即自动进）。
# DEED_DIGEST_AUTO=0 是那条自动判据的一键回滚面。
DEED_DIGEST_AGENTS=
DEED_DIGEST_AUTO=
# 搜索 key：服务端按 ASK_ECHO_SEARCH_INFINITY_API_KEY → WEB_SEARCH_API_KEY → LLM_VOLCENGINE_API_KEY
# → DEEPSEEK_API_KEY → VOLCES_API_KEY 顺序兜底取第一个非空。
# 🔴 生产上这把钥匙目前**另存了一份**在 ~/.dsh/.credentials.yaml（dsh 插件用），
#    轮换时必须两处一起换，漏一处就是"平台问答正常、大脑搜索静默失败"。归一另开一稿。
WEB_SEARCH_API_KEY=
